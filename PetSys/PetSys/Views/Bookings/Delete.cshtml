@model PetSys.Models.Booking

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Booking</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Data-Hora
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Datetime)
        </dd>
        <dt class="col-sm-2">
            Serviço
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.IdServiceNavigation.Desc)
        </dd>
        <dt class="col-sm-2">
            Tutor
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.IdTutorNavigation.Name)
        </dd>
        <dt class="col-sm-2">
            Pet
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.IdTutorNavigation.PetName)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
