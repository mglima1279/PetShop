@model PetSys.Models.Booking

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Booking</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Data-Hora
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Datetime)
        </dd>
        <dt class = "col-sm-2">
            Serviço
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.IdServiceNavigation.Desc)
        </dd>
        <dt class = "col-sm-2">
            Tutor
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.IdTutorNavigation.Name)
        </dd>
        <dt class="col-sm-2">
            Pet
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.IdTutorNavigation.PetName)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
